<?xml version="1.0" encoding="utf-8"?>
<!-- A pass in the list: a compact wallet card - logo on the left, most important header field on the right. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pass_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/pass_card_side_margin"
    android:layout_marginTop="@dimen/pass_card_spacing"
    android:layout_marginEnd="@dimen/pass_card_side_margin"
    app:cardBackgroundColor="@color/card_view_background"
    app:cardCornerRadius="@dimen/pass_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pass_card_height"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <!-- only the logo of the pass on the left (nothing without logo); the header field on the right keeps its width -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/passLogo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pass_card_logo_height"
                android:layout_gravity="start|center_vertical"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="@dimen/pass_card_logo_max_width"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/headerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="@dimen/pass_card_header_max_width"
                android:textAllCaps="true"
                android:textSize="12sp"
                tools:text="Autostadt Key" />

            <TextView
                android:id="@+id/headerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="@dimen/pass_card_header_max_width"
                android:textSize="22sp"
                tools:text="CLASSIC" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
